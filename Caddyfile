# Заміни api.yourdomain.com на свій справжній піддомен
api.maksimkaa.online {
    # Проксування всіх REST API та WebSocket на контейнер backend
    reverse_proxy backend:8000 {
        # Збільшений таймаут для довготривалих WebSocket з'єднань
        flush_interval -1
    }

    # Логування запитів
    log {
        output stdout
        format json
    }
}
